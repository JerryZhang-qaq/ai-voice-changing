# Shell scripts do not automatically source this file. Export settings in your
# shell or use Compose's env_file; never commit real secrets.
WORKBENCH_RUNTIME=runtime
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=8000
# Absolute paths, as seen by the worker process:
RVC_ROOT=/absolute/runtime/engines/rvc
RVC_PYTHON=/absolute/runtime/venvs/rvc/bin/python
SEPARATION_PYTHON=/absolute/runtime/venvs/separation/bin/python
SEPARATION_MODELS=/absolute/runtime/models/separation
